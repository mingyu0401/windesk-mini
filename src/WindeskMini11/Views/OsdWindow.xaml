<Window x:Class="WindeskMini11.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindeskMini11 OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        Opacity="0">

    <Grid x:Name="Stage" Margin="26,18,26,26">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="StageShift" Y="0" />
        </Grid.RenderTransform>

        <Border x:Name="Root"
                CornerRadius="12"
                Padding="16,12,20,12"
                MinWidth="248"
                MaxWidth="420"
                Background="{DynamicResource ToastBgBrush}"
                BorderBrush="{DynamicResource ToastBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="2" Direction="270"
                                  Opacity="0.32" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 自绘图标：四宫格表示桌面图标，隐藏时加一条斜杠 -->
                <Border Width="38" Height="38" CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid Width="17" Height="17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CellA" Grid.Row="0" Grid.Column="0" Margin="0,0,2,2"
                                CornerRadius="1.6" Background="{DynamicResource AccentBrush}" />
                        <Border x:Name="CellB" Grid.Row="0" Grid.Column="1" Margin="2,0,0,2"
                                CornerRadius="1.6" Background="{DynamicResource AccentBrush}" />
                        <Border x:Name="CellC" Grid.Row="1" Grid.Column="0" Margin="0,2,2,0"
                                CornerRadius="1.6" Background="{DynamicResource AccentBrush}" />
                        <Border x:Name="CellD" Grid.Row="1" Grid.Column="1" Margin="2,2,0,0"
                                CornerRadius="1.6" Background="{DynamicResource AccentBrush}" />

                        <Path x:Name="SlashBar" Grid.RowSpan="2" Grid.ColumnSpan="2"
                              Data="M1.5,16 L16,1.5"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="桌面图标已隐藏" />
                    <TextBlock x:Name="SubText"
                               FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="Ctrl+Alt+D · 再按一次恢复" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
