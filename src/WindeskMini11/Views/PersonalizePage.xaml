<UserControl x:Class="WindeskMini11.Views.PersonalizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,28,40,12">
            <TextBlock Text="个性化" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Sub}"
                       Text="清理桌面图标上的覆盖标记，让快捷方式看起来干净统一。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="40,0,26,36">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Text="图标效果" Style="{StaticResource SectionHeader}" Margin="4,8,0,10" />

                <!-- 去除快捷方式小箭头 -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;"
                                       Foreground="{DynamicResource IconTileFgBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="去除快捷方式小箭头" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock x:Name="ArrowBadgeText" Text="未启用" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="把系统「链接覆盖图标」替换为空白图标，快捷方式左下角不再出现小箭头。" />
                        </StackPanel>

                        <ToggleButton x:Name="ArrowToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      Click="ArrowToggle_Click" />
                    </Grid>
                </Border>

                <!-- 去除小盾牌 -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;"
                                       Foreground="{DynamicResource IconTileFgBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="去除桌面图标小盾牌" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock x:Name="ShieldBadgeText" Text="未启用" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="清除以管理员权限运行的快捷方式上的盾牌覆盖标记，桌面图标更整洁。" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="盾牌由目标程序的管理员清单触发，属系统提示；关闭后仍会正常弹出 UAC 提权窗口。" />
                        </StackPanel>

                        <ToggleButton x:Name="ShieldToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      Click="ShieldToggle_Click" />
                    </Grid>
                </Border>

                <!-- 生效说明 -->
                <Border x:Name="RestartHint" Style="{StaticResource InfoBar}" Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="15" Margin="0,2,0,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />

                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock Text="系统级修改说明" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="以上设置写入系统注册表。盾牌和箭头是缓存在图标库里的，点「立即生效」会重启资源管理器并重建图标缓存。" />

                            <Border Style="{StaticResource CodeBlock}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Code}"
                                               Text="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Icons" />
                                    <TextBlock Style="{StaticResource Code}" Margin="0,3,0,0"
                                               Text="29 → C:\Windows\Blank.ico    （小箭头）" />
                                    <TextBlock Style="{StaticResource Code}" Margin="0,2,0,0"
                                               Text="77 → C:\Windows\System32\shell32.dll,50    （小盾牌）" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="RestartBtn" Style="{StaticResource BtnPrimary}"
                                        Content="立即生效" Click="RestartBtn_Click" />
                                <Button x:Name="LaterBtn" Style="{StaticResource BtnSubtle}" Content="稍后处理"
                                        Margin="6,0,0,0" Click="LaterBtn_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="外观" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="界面主题" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="默认跟随 Windows 系统深浅色设置，也可以手动固定。" />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegItem}" Content="跟随系统"
                                             GroupName="Theme" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource SegItem}" Content="浅色"
                                             GroupName="Theme" Checked="Theme_Checked" />
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource SegItem}" Content="深色"
                                             GroupName="Theme" Checked="Theme_Checked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="4,10,0,0"
                           Text="提示：修改只影响当前系统账户的图标显示，不会删除或移动任何文件。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
