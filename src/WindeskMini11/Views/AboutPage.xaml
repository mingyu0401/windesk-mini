<UserControl x:Class="WindeskMini11.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,28,40,12">
            <TextBlock Text="关于" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Sub}" Text="Windesk Mini 的功能说明与系统改动范围。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="40,0,26,36">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <!-- 应用信息 -->
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image Source="/Assets/app.ico" Width="56" Height="56"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Windesk Mini 桌面美化" FontSize="17" FontWeight="SemiBold" />
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock x:Name="VersionBadge" Text="v1.0.0" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="为 Windows 11 打造的桌面图标清理工具：去掉快捷方式小箭头与小盾牌，并用一个快捷键随时隐藏桌面图标。" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="功能" Style="{StaticResource SectionHeader}" Margin="4,18,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Width="26"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource SuccessBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="去除快捷方式小箭头" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="覆盖 Shell Icons 索引 29，快捷方式不再带左下角箭头。" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Width="26"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource SuccessBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="去除桌面图标小盾牌" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="覆盖 Shell Icons 索引 77，去掉需要提权程序图标上的盾牌角标。" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Width="26"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource SuccessBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="可自定义的全局快捷键" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="组合键或单个按键都行：F7、F8 等功能键，甚至右 Alt、左 Ctrl 这类单独的修饰键。按下时会在屏幕底部弹出置顶提示，不抢焦点。" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,10,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Width="26"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource SuccessBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="退出自动恢复" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="程序退出时自动把桌面图标恢复为显示状态，不会留下“空桌面”。" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="系统改动范围" Style="{StaticResource SectionHeader}" Margin="4,18,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Desc}" Margin="0,0,0,6"
                                   Text="本程序只写入以下两个系统级字符串值，不修改、不删除任何文件（除缓存刷新外）。" />
                        <Border Style="{StaticResource CodeBlock}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Code}"
                                           Text="HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Icons" />
                                <TextBlock Style="{StaticResource Code}" Margin="0,4,0,0" Text="· 29 = C:\Windows\Blank.ico" />
                                <TextBlock Style="{StaticResource Code}" Margin="0,2,0,0" Text="· 77 = C:\Windows\System32\shell32.dll,50" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="恢复默认会删除这两个值，并清除 HKCU 下同名的历史残留设置。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="维护" Style="{StaticResource SectionHeader}" Margin="4,18,0,10" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="恢复默认设置" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="移除全部注册表覆盖，恢复默认快捷键与主题，桌面图标会回到 Windows 原生外观。" />
                        </StackPanel>

                        <Button x:Name="ResetBtn" Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                Content="恢复默认" VerticalAlignment="Center" Click="ResetBtn_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="退出程序" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="退出前会自动恢复桌面图标的显示状态并注销全局快捷键。" />
                        </StackPanel>

                        <Button x:Name="ExitBtn" Grid.Column="1" Style="{StaticResource BtnSecondary}"
                                Content="退出" VerticalAlignment="Center" Click="ExitBtn_Click" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="4,14,0,0"
                           Text="Windows 11 桌面美化工具 · 建议在 26100（24H2）及以上版本使用。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
