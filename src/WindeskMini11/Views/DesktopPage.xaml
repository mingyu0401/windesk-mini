<UserControl x:Class="WindeskMini11.Views.DesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,28,40,12">
            <TextBlock Text="快捷操作" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Sub}"
                       Text="用一个快捷键随时隐藏或显示桌面图标，让桌面瞬间变干净。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="40,0,26,36">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                <TextBlock Text="全局快捷键" Style="{StaticResource SectionHeader}" Margin="4,8,0,10" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <!-- 启用 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource IconTile}">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;"
                                           Foreground="{DynamicResource IconTileFgBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="启用全局快捷键" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="程序在后台运行时同样有效，不需要窗口处于最前。" />
                            </StackPanel>

                            <ToggleButton x:Name="HotkeyToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                          Click="HotkeyToggle_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <!-- 快捷键显示 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="快捷键" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="HotkeyHint" Style="{StaticResource Desc}"
                                           Text="点击「更改」后按下新的组合键，Esc 取消。" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="HotkeyChip" CornerRadius="5" Padding="12,5"
                                        Background="{DynamicResource ControlBgBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="HotkeyChipText" Text="Ctrl+Alt+D"
                                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <Button x:Name="HotkeyEditBtn" Content="更改" Style="{StaticResource BtnSecondary}"
                                        Margin="8,0,0,0" Click="HotkeyEditBtn_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <!-- 动作 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="按下快捷键时执行" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="隐藏图标会保留桌面右键菜单，随时可以再显示回来。" />
                            </StackPanel>

                            <Border Grid.Column="1" Style="{StaticResource SegGroup}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ActionToggleIcons" Style="{StaticResource SegItem}"
                                                 Content="隐藏 / 显示图标" GroupName="Action" Checked="Action_Checked" />
                                    <RadioButton x:Name="ActionShowDesktop" Style="{StaticResource SegItem}"
                                                 Content="显示桌面 (Win+D)" GroupName="Action" Checked="Action_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <!-- 悬浮提示 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="按下时显示悬浮提示" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="在屏幕底部中央弹出置顶提示，不抢焦点、不影响正在输入的内容，1.5 秒后自动淡出。" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="预览" Style="{StaticResource BtnSubtle}"
                                        Margin="0,0,10,0" Click="OverlayPreview_Click" />
                                <ToggleButton x:Name="OverlayToggle" Style="{StaticResource ToggleSwitch}"
                                              Click="OverlayToggle_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource InfoBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="15" Margin="0,2,0,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Margin="11,0,0,0" Style="{StaticResource Desc}"
                                   Text="关闭程序时会自动恢复显示桌面图标；若程序异常退出，重新打开本程序也会自动恢复。" />
                    </Grid>
                </Border>

                <TextBlock Text="桌面图标" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;"
                                       Foreground="{DynamicResource IconTileFgBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="桌面图标显示状态" Style="{StaticResource CardTitle}" />
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock x:Name="IconStateText" Text="显示中" Style="{StaticResource BadgeText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="也可以直接点这里切换，效果和快捷键完全一致。" />
                        </StackPanel>

                        <Button x:Name="ToggleIconsBtn" Grid.Column="2" Style="{StaticResource BtnSecondary}"
                                Content="隐藏图标" VerticalAlignment="Center" Click="ToggleIconsBtn_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource IconTile}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;"
                                       Foreground="{DynamicResource IconTileFgBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="刷新资源管理器" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="重启资源管理器让注册表修改立即生效；深度刷新会额外清理图标缓存。" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RestartBtn2" Style="{StaticResource BtnSecondary}" Content="重启"
                                    Click="RestartBtn2_Click" />
                            <Button x:Name="DeepRefreshBtn" Style="{StaticResource BtnSecondary}" Content="深度刷新"
                                    Margin="8,0,0,0" Click="DeepRefreshBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="常规" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Desc}"
                                           Text="关闭后快捷键依然生效，可从托盘图标重新打开或退出。" />
                            </StackPanel>

                            <ToggleButton x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          Click="TrayToggle_Click" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="AutoStartDesc" Style="{StaticResource Desc}"
                                           Text="登录后自动静默启动到托盘。用计划任务以管理员身份运行，不会弹 UAC 确认框。" />
                            </StackPanel>

                            <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          Click="AutoStartToggle_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
