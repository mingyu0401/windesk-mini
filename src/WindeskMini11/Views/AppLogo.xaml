<UserControl x:Class="WindeskMini11.Views.AppLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32">

    <!-- 纯矢量，任意尺寸 / 任意 DPI 都清晰（ico 只有小尺寸帧，拉伸必然发虚） -->
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100">

            <!-- 圆角底板 -->
            <Border CornerRadius="22.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#58B0FF" Offset="0" />
                        <GradientStop Color="#1A56DB" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 顶部高光 -->
            <Border CornerRadius="22.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3DFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.62" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 四宫格 -->
            <Grid Margin="25.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4.25,4.25"
                        CornerRadius="5.2" Background="#A0FFFFFF" />
                <Border Grid.Row="0" Grid.Column="1" Margin="4.25,0,0,4.25"
                        CornerRadius="5.2" Background="#F2FFFFFF" />
                <Border Grid.Row="1" Grid.Column="0" Margin="0,4.25,4.25,0"
                        CornerRadius="5.2" Background="#F2FFFFFF" />
                <Border Grid.Row="1" Grid.Column="1" Margin="4.25,4.25,0,0"
                        CornerRadius="5.2" Background="#F2FFFFFF" />
            </Grid>

            <!-- 右下角金色星芒 -->
            <Path Fill="#FFE27A"
                  Data="M77.5,64 L81.01,73.99 L91,77.5 L81.01,81.01 L77.5,91 L73.99,81.01 L64,77.5 L73.99,73.99 Z" />
        </Grid>
    </Viewbox>
</UserControl>
