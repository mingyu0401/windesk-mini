<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色主题（对齐 Windows 11 设置 · Dark）===== -->

    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Color="#242424" Offset="0" />
        <GradientStop Color="#1B1B1B" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBgBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="#313131" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383838" />
    <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#4C4C4C" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C6C6C6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E8E8E" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#63CBFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3FAFDE" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="#002538" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3849" />
    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#245A73" />

    <SolidColorBrush x:Key="ControlBgBrush" Color="#323232" />
    <SolidColorBrush x:Key="ControlBgHoverBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ControlBgPressedBrush" Color="#484848" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#424242" />
    <SolidColorBrush x:Key="ControlSelectedBgBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlSelectedBorderBrush" Color="#606060" />

    <SolidColorBrush x:Key="ToggleOffBgBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#6F6F6F" />
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleKnobOnBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="DividerBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="NavSelectedBgBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#272727" />
    <SolidColorBrush x:Key="NavGlyphBrush" Color="#D2D2D2" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#565656" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#767676" />

    <SolidColorBrush x:Key="IconTileBgBrush" Color="#383838" />
    <SolidColorBrush x:Key="IconTileFgBrush" Color="#E9E9E9" />

    <SolidColorBrush x:Key="BadgeBgBrush" Color="#1C3B4D" />
    <SolidColorBrush x:Key="BadgeFgBrush" Color="#84DAFF" />
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#265B74" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />

    <SolidColorBrush x:Key="InfoBgBrush" Color="#1D2833" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#2A3B4A" />

    <SolidColorBrush x:Key="ToastBgBrush" Color="#333333" />
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#4F4F4F" />

    <SolidColorBrush x:Key="CodeBgBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="#3A3A3A" />

    <Color x:Key="TitleBarColor">#242424</Color>
    <Color x:Key="TitleBarTextColor">#FFFFFF</Color>

</ResourceDictionary>
