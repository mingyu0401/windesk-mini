<Window x:Class="WindeskMini11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面美化 · Windesk Mini"
        Width="1080" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="AdminDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧导航 ===== -->
        <DockPanel Grid.Column="0">

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,22,20,20">
                <Image Source="/Assets/app.ico" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="桌面美化" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Windesk Mini" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Margin="18,10,18,20" Padding="12,10" CornerRadius="8"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdminDot" Style="{StaticResource AdminDot}" />
                        <TextBlock x:Name="AdminText" Text="管理员权限已启用" FontSize="11.5" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="10.5" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Margin="12,0">
                <TextBlock Text="设置" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <RadioButton x:Name="NavPersonalize" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True"
                             AutomationProperties.AutomationId="NavPersonalize"
                             Checked="Nav_Checked" Tag="personalize">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NavGlyphBrush}" />
                        <TextBlock Text="个性化" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavDesktop" Style="{StaticResource NavItem}" GroupName="Nav"
                             AutomationProperties.AutomationId="NavDesktop"
                             Checked="Nav_Checked" Tag="desktop">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NavGlyphBrush}" />
                        <TextBlock Text="快捷操作" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                             AutomationProperties.AutomationId="NavAbout"
                             Checked="Nav_Checked" Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Width="22" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NavGlyphBrush}" />
                        <TextBlock Text="关于" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />

        <!-- ===== 右侧内容 ===== -->
        <Grid Grid.Column="2" ClipToBounds="True">
            <ContentControl x:Name="PageHost" />

            <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26" Padding="16,10" CornerRadius="8" Panel.ZIndex="20"
                    Background="{DynamicResource ToastBgBrush}"
                    BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastGlyph" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock x:Name="ToastText" Text="" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
