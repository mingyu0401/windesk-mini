<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WindeskMini11</RootNamespace>
    <AssemblyName>WindeskMini11</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <Product>Windesk Mini 桌面美化</Product>
    <AssemblyTitle>Windesk Mini 桌面美化</AssemblyTitle>
    <Company>Windesk</Company>
    <Description>Windows 11 桌面图标美化工具</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF 通过清单声明 PerMonitorV2，无需 WinForms 生成器接管 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
